<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="url-tags-table" author="khrvacic">
        <createTable tableName="url_tags">
            <column name="URL_ID" type="BIGINT">
                <constraints nullable="false" foreignKeyName="URL_TAGS_URL_FK" referencedTableName="URL"
                             referencedColumnNames="ID"/>
            </column>
            <column name="TAG" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="url_tags" indexName="IDX_URL_TAGS_TAG">
            <column name="TAG"/>
        </createIndex>
        <rollback>
            <dropTable tableName="URL_TAGS"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
